.present
    img.present__img(src="/img/hero-bg.webp", alt="hero")

    .container

        h1.present__title Безопасное и бесперебойное газоснабжение потребителей

        p.present__text Самара и Самарская область

        .present-services
            each service in presentServices
                a.present-services__item.box(href="#")
                    .present-services__icon !{service.icon}
                    .present-services__info
                        span.present-services__title= service.title
                        if service.text
                            span.present-services__text= service.text
