section.legal
	.container

		.section-head
			h2.section-title Юридическим лицам
			a.section-more(href="#")
				span Все сервисы
				!= legalIconMore

		.legal__body

			.legal__list
				each item in legalServices
					a.legal__card.box(href="#")
						.legal__card-tile !{item.icon}
						.legal__card-body
							h3.legal__card-title= item.title
							p.legal__card-text= item.text

			a.legal__account(href="#")
				.legal__account-inner
					.legal__account-head
						.legal__account-tile !{legalIconAccount}
						.legal__account-info
							h3.legal__account-title
								| Личный кабинет
								br
								| для юридических лиц
							p.legal__account-text Управление договорами и платежами
					span.legal__account-btn Войти
				.legal__account-img !{legalIconIllustration}
