-
	const faqLinks = [
		'Обязательно ли заключать договор на ТО газового оборудования',
		'Адреса Центров обслуживания клиентов',
		'Подготовка дома к пуску газа',
		'Как подать заявку на социальную газификацию',
		'Связаться и согласовать дату и время проведения ТО ВД(К)ГО',
		'Из чего складывается стоимость ТО ВД(К)ГО: расшифровка квитанции',
		'Узнать дату ТО ВД(К)ГО',
		'Перечень работ по ТО ВД(К)ГО',
		'Реализация сжиженного углеводородного газа в баллонах'
	]

	const faqArrow = `
		<svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path d="M6.375 12.75L10.625 8.5L6.375 4.25" stroke="white" stroke-width="1.41667" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	`

	const faqInfo = `
		<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
			<path d="M10.625 2.125H14.875V6.375" stroke="white" stroke-width="1.41667" stroke-linecap="round" stroke-linejoin="round"/>
			<path d="M7.08337 9.91667L14.875 2.125" stroke="white" stroke-width="1.41667" stroke-linecap="round" stroke-linejoin="round"/>
			<path d="M12.75 9.20833V13.4583C12.75 13.8341 12.6007 14.1944 12.3351 14.4601C12.0694 14.7257 11.7091 14.875 11.3333 14.875H3.54167C3.16594 14.875 2.80561 14.7257 2.53993 14.4601C2.27426 14.1944 2.125 13.8341 2.125 13.4583V5.66667C2.125 5.29094 2.27426 4.93061 2.53993 4.66493C2.80561 4.39926 3.16594 4.25 3.54167 4.25H7.79167" stroke="white" stroke-width="1.41667" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	`

section.faq
	.container

		.faq__body

			.faq__intro
				h2.section-title Вопросы и ответы
				p.faq__subtitle Полезная информация

			.faq__grid
				each link in faqLinks
					a.faq__link(href="#")
						span.faq__link-text= link
						span.faq__link-arrow !{faqArrow}
				a.faq__banner(href="#")
					span.faq__banner-icon !{faqInfo}
					span.faq__banner-text Информация о работе подрядовых организаций по техническому обслуживанию ВДГО и ВКГО
