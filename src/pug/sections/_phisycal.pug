section.services
	.container

		.section-head
			h2.section-title Физическим лицам
			a.section-more(href="#")
				span Все сервисы
				!= iconMore

		.services__categories
			each cat in categories
				a.services__category(href="#", class='services__category--' + cat.theme)
					.services__category-inner
						.services__category-tile !{cat.icon}
						.services__category-body
							h3.services__category-title= cat.title
							ul.services__category-tags
								each tag in cat.tags
									li.services__category-tag= tag
					img.services__category-img(src=cat.img, alt="")
					.services__category-arrow !{iconArr}

		.services__list
			each card in serviceCards
				.services__card.box
					.services__card-tile !{card.icon}
					.services__card-body
						h3.services__card-title= card.title
						p.services__card-text= card.text
						if card.button
							a.services__btn(href="#")
								!= card.button.icon
								span= card.button.text
